    "<svg><foreignObject> ... </svg>": {
        "body": "<svg viewBox=\"${1:0 0 280 200}\" style=\"background: white;\">\n<circle cx=\"100\" cy=\"100\" r=\"80\" fill=\"lightblue\" stroke=\"blue\" stroke-width=\"2\"/>\n<line x1=\"100\" y1=\"100\" x2=\"180\" y2=\"100\" stroke=\"red\" stroke-width=\"2\"/>\n<foreignObject x=\"${2:110}\" y=\"${3:70}\" width=\"${4:100}\" height=\"${5:30}\">\n${6:Radius: \\$r\\$}\n</foreignObject>\n</svg>",
        "description": [
