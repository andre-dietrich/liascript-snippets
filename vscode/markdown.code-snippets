    "<svg> ... </svg>": {
        "body": "<svg viewBox=\"${1:0 0 200 100}\" style=\"${2:background: white;}\">\n  ${3:<circle cx=\"50\" cy=\"50\" r=\"40\" fill=\"lightblue\" stroke=\"blue\" stroke-width=\"2\"/>\n  <rect x=\"110\" y=\"10\" width=\"80\" height=\"80\" fill=\"lightgreen\" stroke=\"green\" stroke-width=\"2\"/>}\n</svg>",
